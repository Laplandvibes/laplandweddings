/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block

/assets/*
  # `immutable` removed 2026-07-28. Filenames are content-hashed, so a year of
  # caching is still correct, but `immutable` also tells the browser not to
  # revalidate even on an explicit reload. Twice now (2026-07-11, 2026-07-28) a
  # bad response got cached under an asset URL and left visitors on a permanently
  # blank page that refreshing could not fix. Without `immutable` the same
  # accident heals on the next reload.
  #
  # `s-maxage=600` added 2026-08-07 (4th poisoning, see vite.config.ts b5).
  # Dropping `immutable` only lets the BROWSER heal on reload; it does nothing
  # for Cloudflare's own copy, which kept serving the fallback HTML under the
  # .js URL. s-maxage expires the CDN copy in 10 minutes while the browser may
  # still keep the content-hashed file for a year. Measured recovery elsewhere
  # in the network: 520 s. Without this line a poisoned edge entry can persist
  # for the full year, which is why this site kept relapsing.
  Cache-Control: public, max-age=31536000, s-maxage=600

/sitemap.xml
  Content-Type: application/xml

/robots.txt
  Content-Type: text/plain
