#   => kuollut polku -> 404.html, aito HTTP 404
#
# 🔴 TURVALLISTA VAIN KOSKA JOKAINEN APPIN REITTI ON PRERENDERÖITY.
# scripts/prerender-meta.mjs ajaa kattavuusportin joka lukee src/App.tsx:n
